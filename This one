<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RetroCore Windows XP Edition</title>
  <style>
    :root {
      --xp-blue-1: #0d5fc7;
      --xp-blue-2: #2d7ae9;
      --xp-blue-3: #7ac0ff;
      --xp-blue-4: #083d87;
      --xp-sky: #eaf3ff;
      --xp-panel: #dfe8f4;
      --xp-window: #f1f2f3;
      --xp-border: #2357b0;
      --xp-taskbar: linear-gradient(to bottom, #3c8df8 0%, #1d62d8 15%, #1c56c0 100%);
      --xp-taskbar-dark: #0d47a1;
      --xp-start: linear-gradient(to bottom, #59c82c 0%, #2b9d18 100%);
      --xp-start-dark: #1c7706;
      --xp-shadow: rgba(0,0,0,0.26);
      --xp-surface: #ffffff;
      --xp-text: #1f1f1f;
      --xp-folder: #f7c15c;
      --xp-file: #dfeaf7;
      --xp-red: #d72626;
      --xp-olive: #71893d;
      --xp-silver: #b7bcc8;
    }

    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      font-family: "Segoe UI", Tahoma, Arial, sans-serif;
      background: #5a7edc;
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
    }

    body {
      background: #5a7edc url('https://wallpapercave.com/wp/wp1814092.jpg') no-repeat center center fixed;
      background-size: cover;
    }

    body.theme-blue {
      --xp-border: #244fca;
      --xp-taskbar: linear-gradient(to bottom, #3b8df7 0%, #2467d6 15%, #1a4cb6 100%);
    }
    body.theme-silver {
      --xp-border: #8a8d94;
      --xp-taskbar: linear-gradient(to bottom, #d7d9df 0%, #aeb7c8 18%, #7d8393 100%);
    }
    body.theme-olive {
      --xp-border: #5c6a31;
      --xp-taskbar: linear-gradient(to bottom, #a7ba73 0%, #889b5f 18%, #56673d 100%);
    }

    [data-tooltip] { position: relative; }
    [data-tooltip]::after {
      content: attr(data-tooltip);
      position: absolute;
      bottom: 130%; left: 50%;
      transform: translateX(-50%);
      background: #ffffe1; color: #000; border: 1px solid #000;
      padding: 3px 6px; font-size: 10px; white-space: nowrap; z-index: 999999;
      display: none; box-shadow: 2px 2px 4px rgba(0,0,0,0.2); border-radius: 2px;
    }
    [data-tooltip]:hover::after { display: block; }

    #boot-screen {
      position: fixed; inset: 0; background: #000; z-index: 9999999;
      display: flex; align-items: center; justify-content: center; color: #fff; font-family: "Segoe UI", Tahoma, sans-serif;
      padding: 20px;
    }

    .xp-boot-center {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      width: min(90vw, 500px);
      text-align: center;
    }

    .xp-logo-wrap {
      display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 14px;
    }
    .xp-logo {
      width: 54px; height: 54px; position: relative;
      background: linear-gradient(135deg, #2f82ff 0%, #0d56c7 100%);
      border-radius: 10px; box-shadow: inset 0 0 0 2px rgba(255,255,255,0.35);
      overflow: hidden;
    }
    .xp-logo::before, .xp-logo::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(to right, transparent 0 40%, rgba(255,255,255,0.8) 40% 52%, transparent 52% 100%);
      transform: skewX(-20deg);
    }
    .xp-logo::after {
      background: linear-gradient(90deg, rgba(255,255,255,0.2), rgba(255,255,255,0.7), rgba(255,255,255,0.2));
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
      opacity: 0.9;
    }

    .xp-brand {
      font-size: 22pt; font-weight: 700; letter-spacing: 1px; color: #dfeeff;
      text-shadow: 0 0 16px rgba(93, 160, 255, 0.7);
    }
    .xp-subtitle {
      display: block; margin-top: 6px; font-size: 11pt; letter-spacing: 5px; color: #a8d7ff; font-weight: 600;
    }
    .boot-progress-container {
      width: min(80vw, 260px); height: 16px; border: 2px solid rgba(255,255,255,0.7); padding: 1px; border-radius: 3px;
      background: rgba(0,0,0,0.75); margin: 20px 0 16px;
      box-shadow: inset 0 0 12px rgba(0,0,0,0.8);
    }
    .boot-progress-bar {
      width: 100%; height: 100%; display: flex; gap: 3px; overflow: hidden;
      position: relative;
      background: rgba(255,255,255,0.06);
    }
    .boot-block {
      width: 18px; height: 100%; background: linear-gradient(to bottom, #7bd0ff, #1d74ea, #7bd0ff);
      flex-shrink: 0; animation: loadingXP 1.8s infinite linear;
      border-radius: 2px;
    }
    @keyframes loadingXP {
      0% { transform: translateX(-220px); opacity: 0.2; }
      30% { opacity: 1; }
      100% { transform: translateX(220px); opacity: 0.2; }
    }

    #boot-console {
      width: min(90vw, 500px); height: 120px; background: rgba(0,0,0,0.8); border: 1px solid rgba(255,255,255,0.2);
      padding: 10px; font-size: 9pt; color: #7ef98d; overflow-y: hidden; text-align: left;
      box-shadow: inset 0 0 12px rgba(126,249,141,0.15);
      font-family: "Consolas", monospace;
    }

    #desktop {
      width: 100%; height: calc(100vh - 30px); padding: 16px; display: flex; flex-direction: column; flex-wrap: wrap;
      align-content: flex-start; gap: 18px; position: relative;
    }

    .desktop-icon {
      width: 90px; text-align: center; color: white; cursor: pointer; display: flex; flex-direction: column; align-items: center;
      text-shadow: 2px 2px 3px rgba(0,0,0,0.9); font-weight: 500; padding: 5px; border: 1px solid transparent; border-radius: 3px;
      transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
    }
    .desktop-icon:hover {
      background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.25);
    }
    .desktop-icon:active { transform: translateY(1px); }
    .desktop-icon img {
      width: 36px; height: 36px; margin-bottom: 5px; display: block; border-radius: 4px;
      background: rgba(255,255,255,0.08);
    }
    .desktop-icon span { display: block; line-height: 1.2; }

    .window {
      width: 520px; height: 350px; background: #f1f2f3; border: 2px solid var(--xp-border);
      border-top-left-radius: 4px; border-top-right-radius: 4px; position: absolute; z-index: 100;
      display: none; box-shadow: 4px 6px 22px rgba(0,0,0,0.32); transform: scale(0.96); opacity: 0;
      transition: transform 0.15s ease-out, opacity 0.15s ease-out;
      touch-action: none;
    }
    .window.window-open { transform: scale(1); opacity: 1; }
    .window-header {
      background: linear-gradient(to bottom, #3f8ef5 0%, #1f67da 18%, #1a4da1 100%);
      color: white; font-weight: 700; padding: 4px 8px; font-size: 11px; display: flex;
      justify-content: space-between; align-items: center; cursor: move; height: 28px;
      user-select: none; -webkit-user-select: none;
      touch-action: none;
      border-bottom: 1px solid rgba(0,0,0,0.3);
    }
    .window-title-area {
      display: flex; align-items: center; gap: 6px; min-width: 0;
      overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
    }
    .window-title-icon {
      width: 15px; height: 15px; background: #fff; border-radius: 2px; display: inline-flex;
      align-items: center; justify-content: center; color: #333; font-size: 9px; line-height: 1;
    }
    .window-controls { display: flex; gap: 2px; }
    .window-controls button {
      color: white; font-weight: bold; font-size: 9px; border-radius: 2px; width: 22px; height: 18px; cursor: pointer;
      border: 1px solid rgba(0,0,0,0.3); padding: 0; box-shadow: inset 0 1px 0 rgba(255,255,255,0.3);
    }
    .win-btn-min, .win-btn-max { background: linear-gradient(to bottom, #4c90f0, #2b62d5); }
    .win-btn-close { background: linear-gradient(to bottom, #e86852 0%, #c53f27 100%); }
    .win-btn-close:hover { background: #ff3300; }
    .window-body {
      padding: 10px; font-size: 11px; color: var(--xp-text); background: var(--xp-surface); height: calc(100% - 28px); overflow: auto; position: relative;
    }
    .window.maximized { width: 100% !important; height: calc(100vh - 30px) !important; top: 0 !important; left: 0 !important; }

    .explorer-layout { display: flex; height: 100%; }
    .explorer-sidebar {
      width: 138px; background: linear-gradient(to bottom, #b9d2ff 0%, #9dbef4 100%);
      border-right: 1px solid #7a9bd2; padding: 8px; color: #0b2a5c;
    }
    .sidebar-folder {
      padding: 6px 8px; cursor: pointer; border-radius: 3px; font-weight: 700; margin-bottom: 5px;
      background: rgba(255,255,255,0.15); border: 1px solid transparent;
    }
    .sidebar-folder:hover { background: rgba(255,255,255,0.3); border-color: rgba(0,0,0,0.08); }
    .explorer-main {
      flex-grow: 1; padding: 12px; display: flex; flex-wrap: wrap; gap: 12px; background: #ffffff; align-content: flex-start;
    }
    .explorer-item {
      width: 72px; text-align: center; cursor: pointer; font-size: 10px; line-height: 1.2; color: #1a1a1a;
      padding: 4px 2px; border-radius: 4px; transition: background 0.1s ease;
    }
    .explorer-item:hover { background: rgba(0, 120, 215, 0.08); }
    .explorer-item .item-icon {
      width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; margin: 0 auto 5px;
      font-size: 26px; border-radius: 6px; color: #ffb850;
    }
    .explorer-item.file .item-icon { color: #d9e5fb; }

    .nav-bar { display: flex; gap: 4px; margin-bottom: 8px; background: #edf3fb; padding: 5px; border-bottom: 1px solid #c9d7ea; align-items: center; }
    .nav-input { flex-grow: 1; border: 1px solid #7f9db9; padding: 3px 6px; font-size: 11px; background: #fff; }
    .nav-btn { background: linear-gradient(to bottom, #fefefe, #e9edf7); border: 1px solid #9caac2; border-radius: 3px; cursor: pointer; padding: 3px 10px; font-weight: 600; }
    .web-content { width: 100%; height: calc(100% - 40px); background: #fff; border: 1px solid #c1c8d7; padding: 12px; overflow-y: auto; }

    #snakeGameCanvas { border: 2px solid var(--xp-border); background: #0d0d0d; display: block; margin: 0 auto; }
    .snake-dashboard { display: flex; justify-content: space-between; font-weight: 700; background: #f0f0f0; padding: 6px; border-radius: 4px; margin-top: 6px; }

    .ctrl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .ctrl-card { border: 1px solid #cfd6e6; padding: 10px; border-radius: 4px; background: #fafbfd; }
    .ctrl-card h5 { margin: 0 0 6px 0; font-size: 11px; color: #245edb; }

    .player-box { background: #222; color: #00ff00; padding: 12px; border-radius: 6px; font-family: monospace; text-align: center; }
    .player-controls { display: flex; justify-content: center; gap: 10px; margin-top: 10px; }
    .player-btn { background: #444; border: 1px solid #666; color: white; padding: 4px 10px; cursor: pointer; font-size: 10px; font-family: monospace; }
    .player-btn:hover { background: #666; }
    .music-progress { width: 100%; background: #444; height: 6px; margin-top: 10px; border-radius: 3px; overflow: hidden; }
    .music-bar { width: 0%; height: 100%; background: #00ff00; transition: width 0.5s linear; }

    .notepad-textarea { width: 100%; height: calc(100% - 30px); border: 1px solid #c7c7c7; resize: none; font-family: Consolas, monospace; padding: 5px; font-size: 12px; }

    .cmd-box { background: #000; color: #fff; font-family: Consolas, monospace; height: 100%; padding: 5px; overflow-y: auto; }
    .cmd-output { white-space: pre-wrap; margin-bottom: 5px; line-height: 1.3; }
    .cmd-input-line { display: flex; }
    .cmd-prompt { color: #00ff00; font-weight: bold; margin-right: 5px; }
    .cmd-field { background: transparent; border: none; color: white; font-family: Consolas, monospace; outline: none; flex-grow: 1; font-size: 11px; }

    #start-menu {
      position: fixed; bottom: 30px; left: 0; width: 280px; background: #fff; border: 2px solid var(--xp-border);
      border-top-right-radius: 5px; box-shadow: 3px -3px 20px rgba(0,0,0,0.4); display: none; z-index: 99999;
    }
    .start-header {
      background: linear-gradient(to bottom, #2f69d8 0%, #2148a9 100%); color: white; padding: 10px; font-weight: 700;
      display: flex; align-items: center; gap: 8px; font-size: 12px; border-bottom: 1px solid rgba(0,0,0,0.15);
    }
    .start-header img { width: 24px; height: 24px; border-radius: 50%; border: 1px solid white; }
    .start-menu-list { padding: 4px 0; background: #fff; position: relative; }
    .start-menu-item { padding: 8px 15px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; color: #222; position: relative; }
    .start-menu-item:hover { background: #316ac5; color: white; }
    .start-submenu {
      position: absolute; left: 100%; top: 0; width: 180px; background: white; border: 2px solid var(--xp-border);
      display: none; box-shadow: 3px 3px 10px rgba(0,0,0,0.2); z-index: 100000; padding: 4px 0;
    }
    .start-menu-item:hover > .start-submenu { display: block; }
    .submenu-item { padding: 6px 12px; color: #333; cursor: pointer; }
    .submenu-item:hover { background: #316ac5; color: white; }
    .start-footer { background: #dce7fb; padding: 6px; text-align: right; border-top: 1px solid #a9c1eb; }
    .shutdown-btn { background: linear-gradient(to bottom, #e56c43, #b63113); color: white; border: 1px solid #7a1b07; padding: 4px 10px; font-weight: 700; cursor: pointer; border-radius: 3px; }

    #shutdown-dialog {
      position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 320px; background: #5a7edc;
      border: 3px solid #0011a0; border-radius: 6px; padding: 15px; color: white; text-align: center; z-index: 999998; display: none;
      box-shadow: 0px 10px 30px rgba(0,0,0,0.6);
    }
    .shutdown-options { display: flex; justify-content: space-around; margin-top: 15px; }
    .shutdown-opt-btn { background: #f0f0f0; border: 2px solid #333; border-radius: 4px; padding: 6px 12px; font-weight: bold; cursor: pointer; color: black; }
    .shutdown-opt-btn:hover { background: #ddd; }

    #taskbar {
      background: var(--xp-taskbar); position: fixed; bottom: 0; left: 0; width: 100%; height: 30px; display: flex; align-items: center; z-index: 99999;
      box-shadow: inset 0 1px 1px rgba(255,255,255,0.38);
    }
    #start-button {
      height: 100%; width: 100px; background: linear-gradient(to bottom, #60af47 0%, #398a23 100%); border-top-right-radius: 7px; border-bottom-right-radius: 7px;
      color: white; font-weight: 700; font-style: italic; font-size: 13pt; display: flex; align-items: center; justify-content: center; cursor: pointer;
      text-shadow: 1px 1px 2px #225511; border: none; box-shadow: inset 0 1px 0 rgba(255,255,255,0.3);
    }
    #start-button:active { background: linear-gradient(to bottom, #398a23 0%, #296419 100%); }
    #open-apps-container { display: flex; gap: 4px; margin-left: 10px; align-items: center; }
    .taskbar-app-btn {
      background: linear-gradient(to bottom, #3a7de5, #1f4994); color: white; border: 1px solid #112a59; border-radius: 3px; padding: 2px 8px; height: 24px;
      cursor: pointer; font-size: 10px; max-width: 110px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .taskbar-app-btn.active-app { background: #1e4287; font-weight: bold; border-color: #fff; }
    #taskbar-right {
      margin-left: auto; background: linear-gradient(to bottom, #0f69e4, #0046b7); color: white; height: 100%; display: flex; align-items: center; gap: 8px;
      padding: 0 12px; font-size: 10px; border-left: 1px solid #0c3374;
    }
    .stream-toggle-tb { background: #ff00ff; border: none; color: white; padding: 2px 6px; font-weight: 700; cursor: pointer; border-radius: 2px; font-size: 9px; }

    @keyframes windowVibrate {
      0% { transform: translate(1px, 1px) rotate(0deg); }
      50% { transform: translate(-2px, -1px) rotate(1deg); }
      100% { transform: translate(2px, -1px) rotate(-1deg); }
    }
    .vibrate-active { animation: windowVibrate 0.1s infinite !important; }

    #virus-ransom-box {
      position: fixed; top: 40%; left: 50%; transform: translate(-50%, -50%); width: 360px; background: #fff; border: 4px solid #cc0000;
      z-index: 999997; box-shadow: 0 0 30px rgba(255,0,0,0.8); display: none; padding: 15px; text-align: center;
    }
    #bsod {
      position: fixed; inset: 0; background-color: #0000aa; color: white; font-family: 'Courier New', monospace; padding: 50px; font-size: 12pt;
      z-index: 9999999; display: none; line-height: 1.5;
    }

    @media (max-width: 700px) {
      #desktop {
        padding-top: 10px; gap: 10px;
      }
      .desktop-icon {
        width: 76px;
      }
      .window {
        width: min(88vw, 440px);
        min-width: 260px;
      }
      .explorer-layout {
        flex-direction: column;
      }
      .explorer-sidebar {
        width: 100%; border-right: none; border-bottom: 1px solid #7a9bd2;
      }
      .ctrl-grid { grid-template-columns: 1fr; }
      #start-menu { width: 240px; }
    }
  </style>
</head>
