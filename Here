<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>RetroCore Mobile Desktop</title>
  <style>
    :root {
      --taskbar-h: 56px;
      --xp-blue: #245edb;
      --xp-header: linear-gradient(to bottom, #2a6ae8 0%, #4aa2ff 18%, #1e4ebd 100%);
      --xp-taskbar: linear-gradient(to bottom, #2d71ef 0%, #1f57c6 100%);
      --border: #173d93;
      --panel: rgba(255,255,255,0.9);
    }

    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: "Segoe UI", Tahoma, sans-serif;
      background: #4fb0ff;
      color: #fff;
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
    }

    body {
      background-image: url('image.jpeg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    #desktop {
      position: absolute;
      left: 0;
      top: 0;
      right: 0;
      bottom: var(--taskbar-h);
      padding: 18px 12px 12px 12px;
      display: flex;
      flex-wrap: wrap;
      align-content: flex-start;
      gap: 12px;
    }

    .desktop-icon {
      width: 82px;
      padding: 6px 4px;
      border-radius: 8px;
      text-align: center;
      color: white;
      font-size: 11px;
      font-weight: 700;
      text-shadow: 0 2px 5px rgba(0,0,0,0.7);
      cursor: pointer;
      position: relative;
      user-select: none;
    }
    .desktop-icon:active { transform: scale(0.98); }
    .desktop-icon .folder-icon {
      display: block;
      font-size: 34px;
      line-height: 1;
      margin-bottom: 6px;
    }
    .desktop-icon:hover {
      background: rgba(255,255,255,0.15);
      outline: 1px solid rgba(255,255,255,0.35);
    }

    .window {
      position: absolute;
      width: min(88vw, 520px);
      height: min(78vh, 400px);
      background: rgba(255,255,255,0.96);
      border: 3px solid var(--border);
      border-radius: 10px 10px 0 0;
      box-shadow: 0 12px 30px rgba(0,0,0,0.35);
      overflow: hidden;
      display: none;
      z-index: 10;
      touch-action: none;
    }
    .window.open { display: block; }

    .window-header {
      height: 32px;
      background: var(--xp-header);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 8px 0 6px;
      cursor: grab;
      user-select: none;
      touch-action: none;
    }
    .window-header:active { cursor: grabbing; }

    .window-title {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 700;
      font-size: 12px;
      color: white;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .window-title-icon {
      font-size: 16px;
      flex: 0 0 auto;
    }

    .window-controls {
      display: flex;
      gap: 4px;
      align-items: center;
    }
    .window-controls button {
      width: 20px;
      height: 18px;
      border: 1px solid rgba(0,0,0,0.25);
      background: linear-gradient(#4c8be6, #2149a6);
      color: white;
      font-weight: 700;
      border-radius: 3px;
      padding: 0;
      cursor: pointer;
      font-size: 11px;
    }
    .window-controls .close-btn {
      background: linear-gradient(#ea5a48, #b63a1e);
    }

    .window-body {
      height: calc(100% - 32px);
      background: #ffffff;
      color: #111;
      padding: 10px;
      overflow: auto;
    }

    #taskbar {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: var(--taskbar-h);
      background: var(--xp-taskbar);
      border-top: 1px solid rgba(255,255,255,0.3);
      display: flex;
      align-items: center;
      padding: 0 8px;
      z-index: 20;
    }

    #start-button {
      background: linear-gradient(#62c14e, #357d2b);
      color: white;
      border: none;
      border-radius: 0 8px 8px 0;
      height: 100%;
      min-width: 92px;
      font-size: 18px;
      font-weight: 800;
      font-style: italic;
      cursor: pointer;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.3);
    }

    #taskbar-apps {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-left: 8px;
      overflow: hidden;
      flex: 1;
    }

    .task-app {
      background: linear-gradient(#4c8be6, #1c4ca8);
      color: white;
      border: 1px solid rgba(0,0,0,0.35);
      border-radius: 6px;
      padding: 4px 8px;
      font-size: 10px;
      font-weight: 700;
      max-width: 120px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      cursor: pointer;
    }

    #taskbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-left: 8px;
      background: rgba(10,54,149,0.45);
      border-left: 1px solid rgba(255,255,255,0.3);
      padding: 0 10px;
      height: 100%;
      font-size: 11px;
      font-weight: 700;
    }

    .stream-btn {
      border: none;
      background: #ff00ff;
      color: white;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 700;
      cursor: pointer;
    }

    .start-menu {
      position: absolute;
      left: 0;
      bottom: var(--taskbar-h);
      width: min(72vw, 280px);
      background: rgba(255,255,255,0.95);
      border: 2px solid var(--border);
      border-radius: 8px 8px 0 0;
      box-shadow: 0 12px 20px rgba(0,0,0,0.25);
      color: #111;
      display: none;
      z-index: 30;
    }
    .start-menu.show { display: block; }

    .start-header {
      background: var(--xp-header);
      color: white;
      padding: 10px 12px;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .start-item {
      padding: 10px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(0,0,0,0.08);
      cursor: pointer;
      font-weight: 600;
    }
    .start-item:hover { background: rgba(36,94,219,0.08); }
    .start-footer {
      padding: 8px 10px;
      background: rgba(200,220,245,0.8);
      text-align: right;
    }
    .start-footer button {
      background: linear-gradient(#e55b48, #b93a23);
      color: white;
      border: none;
      border-radius: 4px;
      padding: 7px 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .explorer-layout {
      display: flex;
      height: 100%;
      background: #f7f7f7;
    }
    .explorer-side {
      width: 130px;
      background: #dfe9ff;
      border-right: 1px solid #c5d3f1;
      padding: 8px;
    }
    .side-item {
      padding: 8px 6px;
      border-radius: 5px;
      cursor: pointer;
      font-weight: 700;
      color: #1a2d60;
    }
    .side-item:hover { background: rgba(36,94,219,0.12); }
    .explorer-main {
      flex: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      padding: 10px;
      align-content: flex-start;
      overflow: auto;
    }
    .file-item {
      width: 72px;
      text-align: center;
      font-size: 10px;
      font-weight: 700;
      color: #333;
      cursor: pointer;
    }
    .file-item .mini-icon { font-size: 28px; display: block; margin-bottom: 4px; }

    .browser-bar {
      display: flex;
      gap: 6px;
      align-items: center;
      background: #f0f0f0;
      padding: 6px;
      border-bottom: 1px solid #d7d7d7;
    }
    .browser-bar input {
      flex: 1;
      border: 1px solid #9bb7dd;
      height: 28px;
      padding: 0 8px;
      font-size: 12px;
    }
    .browser-bar button {
      border: 1px solid #a7a7a7;
      background: #fff;
      border-radius: 4px;
      padding: 6px 10px;
      font-weight: 700;
      cursor: pointer;
    }
    .browser-view {
      height: calc(100% - 40px);
      overflow: auto;
      padding: 12px;
      background: white;
    }

    .player-box {
      background: #1d1d1d;
      border-radius: 8px;
      padding: 12px;
      color: #00ff00;
      font-family: monospace;
      text-align: center;
    }
    .track-progress { margin-top: 12px; background: #333; height: 8px; border-radius: 4px; overflow: hidden; }
    .track-progress > div { height: 100%; width: 0; background: #00ff00; }
    .player-controls {
      margin-top: 12px;
      display: flex;
      justify-content: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .player-controls button {
      background: #444;
      border: 1px solid #666;
      color: white;
      border-radius: 4px;
      padding: 5px 9px;
      font-family: monospace;
      cursor: pointer;
    }

    .snake-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      height: 100%;
      justify-content: center;
    }
    canvas {
      width: min(100%, 320px);
      height: auto;
      background: #0d0d0d;
      border: 2px solid rgba(35, 94, 219, 0.8);
      border-radius: 6px;
      image-rendering: pixelated;
    }
    .snake-scorebar {
      display: flex;
      justify-content: space-between;
      width: min(100%, 320px);
      background: #efefef;
      border-radius: 6px;
      padding: 6px 8px;
      font-size: 12px;
      font-weight: 700;
      color: #111;
    }
    .snake-buttons {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      width: min(100%, 220px);
      margin-top: 4px;
    }
    .snake-buttons button {
      border: 1px solid #b4b4b4;
      background: #fff;
      border-radius: 6px;
      padding: 8px 0;
      font-weight: 800;
      cursor: pointer;
    }

    .mobile-controls {
      display: none;
      position: absolute;
      left: 18px;
      right: 18px;
      bottom: 82px;
      justify-content: center;
      pointer-events: none;
      z-index: 15;
    }
    .mobile-pad {
      display: grid;
      grid-template-columns: repeat(3, 52px);
      grid-template-rows: repeat(3, 52px);
      gap: 8px;
      pointer-events: auto;
    }
    .mobile-pad button {
      border: 1px solid rgba(0,0,0,0.25);
      border-radius: 12px;
      background: rgba(255,255,255,0.7);
      backdrop-filter: blur(4px);
      font-size: 24px;
      font-weight: 800;
      cursor: pointer;
    }
    .mobile-pad .up { grid-column: 2; grid-row: 1; }
    .mobile-pad .left { grid-column: 1; grid-row: 2; }
    .mobile-pad .center { grid-column: 2; grid-row: 2; background: rgba(255,255,255,0.5); }
    .mobile-pad .right { grid-column: 3; grid-row: 2; }
    .mobile-pad .down { grid-column: 2; grid-row: 3; }

    @media (max-width: 768px) {
      .mobile-controls { display: flex; }
      .window {
        width: min(92vw, 500px);
        height: min(62vh, 360px);
      }
      #desktop { padding-left: 8px; padding-right: 8px; }
      .desktop-icon {
        width: 68px;
        font-size: 10px;
      }
      .desktop-icon .folder-icon { font-size: 28px; }
      #taskbar { height: 58px; }
      #start-button { min-width: 82px; font-size: 17px; }
      .task-app { max-width: 90px; padding: 4px 6px; }
      #taskbar-right { font-size: 10px; }
    }
  </style>
</head>
<body>
  <div id="desktop">
    <div class="desktop-icon" data-window="explorer"><span class="folder-icon">📁</span>Explorer</div>
    <div class="desktop-icon" data-window="snake"><span class="folder-icon">📁</span>Snake</div>
    <div class="desktop-icon" data-window="music"><span class="folder-icon">📁</span>Music</div>
    <div class="desktop-icon" data-window="control"><span class="folder-icon">📁</span>Settings</div>
    <div class="desktop-icon" data-window="notes"><span class="folder-icon">📁</span>Notes</div>
    <div class="desktop-icon" data-window="cmd"><span class="folder-icon">📁</span>CMD</div>
  </div>

  <div class="window" id="explorer" style="left: 46px; top: 34px; width: min(90vw, 500px); height: min(72vh, 360px);">
    <div class="window-header">
      <div class="window-title"><span class="window-title-icon">📁</span><span>Explorer</span></div>
      <div class="window-controls">
        <button>_</button>
        <button>[]</button>
        <button class="close-btn" data-close="explorer">X</button>
      </div>
    </div>
    <div class="window-body" style="padding:0;">
      <div class="explorer-layout">
        <div class="explorer-side">
          <div class="side-item" data-folder="docs">My Documents</div>
          <div class="side-item" data-folder="games">Games</div>
          <div class="side-item" data-folder="downloads">Downloads</div>
        </div>
        <div class="explorer-main" id="explorer-main">
          <div class="file-item"><span class="mini-icon">📄</span>Note.txt</div>
          <div class="file-item"><span class="mini-icon">📄</span>Ideas.md</div>
        </div>
      </div>
    </div>
  </div>

  <div class="window" id="snake" style="left: 86px; top: 72px; width: min(90vw, 380px); height: min(74vh, 420px);">
    <div class="window-header">
      <div class="window-title"><span class="window-title-icon">📁</span><span>Snake Ultra</span></div>
      <div class="window-controls"><button class="close-btn" data-close="snake">X</button></div>
    </div>
    <div class="window-body">
      <div class="snake-wrap">
        <canvas id="snakeCanvas" width="300" height="220" aria-label="Snake game"></canvas>
        <div class="snake-scorebar">
          <span>Score: <strong id="snake-score">0</strong></span>
          <span>Best: <strong id="snake-best">0</strong></span>
        </div>
        <div class="snake-buttons">
          <button onclick="setSnakeMode('normal')">Normal</button>
          <button onclick="setSnakeMode('turbo')">Turbo</button>
          <button onclick="setSnakeMode('infinite')">∞</button>
        </div>
      </div>
    </div>
  </div>

  <div class="window" id="music" style="left: 120px; top: 96px; width: min(88vw, 360px); height: min(52vh, 260px);">
    <div class="window-header">
      <div class="window-title"><span class="window-title-icon">📁</span><span>RetroMusic</span></div>
      <div class="window-controls"><button class="close-btn" data-close="music">X</button></div>
    </div>
    <div class="window-body">
      <div class="player-box">
        <div id="track-name">No track loaded</div>
        <div id="track-status">Status: Stopped</div>
        <div class="track-progress"><div id="track-bar"></div></div>
        <div class="player-controls">
          <button onclick="controlMusic('prev')">⏮</button>
          <button onclick="controlMusic('play')">▶</button>
          <button onclick="controlMusic('pause')">⏸</button>
          <button onclick="controlMusic('next')">⏭</button>
        </div>
      </div>
    </div>
  </div>

  <div class="window" id="control" style="left: 150px; top: 120px; width: min(88vw, 420px); height: min(58vh, 300px);">
    <div class="window-header">
      <div class="window-title"><span class="window-title-icon">📁</span><span>Settings</span></div>
      <div class="window-controls"><button class="close-btn" data-close="control">X</button></div>
    </div>
    <div class="window-body">
      <label style="display:block; margin-bottom:10px; font-weight:700;">Desktop background</label>
      <select id="bg-select" style="width:100%; padding:8px;">
        <option value="image.jpeg">Default</option>
        <option value="">No image</option>
      </select>
    </div>
  </div>

  <div class="window" id="notes" style="left: 110px; top: 90px; width: min(88vw, 420px); height: min(62vh, 320px);">
    <div class="window-header">
      <div class="window-title"><span class="window-title-icon">📁</span><span>Notes</span></div>
      <div class="window-controls"><button class="close-btn" data-close="notes">X</button></div>
    </div>
    <div class="window-body">
      <textarea style="width:100%; height:100%; resize:none; border:1px solid #cfcfcf; padding:10px; font-size:14px;" placeholder="Write your notes here..."></textarea>
    </div>
  </div>

  <div class="window" id="cmd" style="left: 70px; top: 150px; width: min(90vw, 480px); height: min(60vh, 300px);">
    <div class="window-header">
      <div class="window-title"><span class="window-title-icon">📁</span><span>CMD</span></div>
      <div class="window-controls"><button class="close-btn" data-close="cmd">X</button></div>
    </div>
    <div class="window-body" style="padding:0; background:#000; color:#fff; font-family:monospace;">
      <div style="padding:8px; height:100%; overflow:auto;">
        <div id="cmd-output">RetroCore Mobile Shell<br>Type help</div>
        <div style="display:flex; margin-top:8px; align-items:center;">
          <span style="color:#00ff00; margin-right:6px;">></span>
          <input id="cmd-input" type="text" style="flex:1; border:none; background:transparent; color:#fff; outline:none; font-family:monospace; font-size:12px;" />
        </div>
      </div>
    </div>
  </div>

  <div class="start-menu" id="start-menu">
    <div class="start-header">👤 Angelo_Streamer</div>
    <div class="start-item" data-open="explorer">Explorer <span>▶</span></div>
    <div class="start-item" data-open="snake">Snake <span>▶</span></div>
    <div class="start-item" data-open="music">Music <span>▶</span></div>
    <div class="start-item" data-open="control">Settings <span>▶</span></div>
    <div class="start-footer"><button onclick="toggleStartMenu();">Shut Down</button></div>
  </div>

  <div id="taskbar">
    <button id="start-button" onclick="toggleStartMenu()">start</button>
    <div id="taskbar-apps"></div>
    <div id="taskbar-right">
      <button class="stream-btn" id="stream-btn" onclick="toggleStreamMode()">STREAM OFF</button>
      <span id="clock">00:00</span>
    </div>
  </div>

  <div class="mobile-controls">
    <div class="mobile-pad">
      <button class="up" data-dir="up">▲</button>
      <button class="left" data-dir="left">◀</button>
      <button class="center" aria-label="pause">●</button>
      <button class="right" data-dir="right">▶</button>
      <button class="down" data-dir="down">▼</button>
    </div>
  </div>

  <script>
    const appList = ['explorer', 'snake', 'music', 'control', 'notes', 'cmd'];
    const opened = {};

    function openWindow(id) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.add('open');
      el.style.zIndex = (appList.indexOf(id) + 20) * 10 + 100;
      opened[id] = true;
      renderTaskbar();
    }

    function closeWindow(id) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.remove('open');
      delete opened[id];
      renderTaskbar();
    }

    document.querySelectorAll('[data-window]').forEach(icon => {
      icon.addEventListener('click', () => openWindow(icon.dataset.window));
    });
    document.querySelectorAll('[data-close]').forEach(btn => {
      btn.addEventListener('click', () => closeWindow(btn.dataset.close));
    });
    document.querySelectorAll('.start-item').forEach(item => {
      item.addEventListener('click', () => {
        const target = item.dataset.open;
        if (target) openWindow(target);
        toggleStartMenu();
      });
    });

    function renderTaskbar() {
      const bar = document.getElementById('taskbar-apps');
      bar.innerHTML = '';
      Object.keys(opened).forEach(id => {
        const btn = document.createElement('button');
        btn.className = 'task-app';
        btn.textContent = id.charAt(0).toUpperCase() + id.slice(1);
        btn.addEventListener('click', () => openWindow(id));
        bar.appendChild(btn);
      });
    }

    function toggleStartMenu() {
      const menu = document.getElementById('start-menu');
      menu.classList.toggle('show');
    }

    document.getElementById('bg-select').addEventListener('change', (e) => {
      if (e.target.value) {
        document.body.style.backgroundImage = "url('" + e.target.value + "')";
      } else {
        document.body.style.backgroundImage = 'none';
        document.body.style.background = '#7ec4ff';
      }
    });

    document.querySelectorAll('.side-item').forEach(item => {
      item.addEventListener('click', () => {
        const main = document.getElementById('explorer-main');
        const folder = item.dataset.folder;
        const files = {
          docs: ['Letter.txt', 'Plan.md', 'Notes.docx'],
          games: ['Snake.exe', 'Puzzle.zip', 'Arcade.pkg'],
          downloads: ['movie.mp4', 'image.png', 'setup.exe']
        };
        main.innerHTML = '';
        files[folder].forEach(file => {
          const div = document.createElement('div');
          div.className = 'file-item';
          div.innerHTML = '<span class="mini-icon">📄</span>' + file;
          main.appendChild(div);
        });
      });
    });

    document.getElementById('cmd-input').addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const val = e.target.value.trim();
      const out = document.getElementById('cmd-output');
      out.innerHTML += '<br>> ' + val;
      if (val === 'help') {
        out.innerHTML += '<br>Commands: help, open snake, open music, open explorer';
      } else if (val === 'open snake') {
        openWindow('snake');
      } else if (val === 'open music') {
        openWindow('music');
      } else if (val === 'open explorer') {
        openWindow('explorer');
      } else if (val === 'clear') {
        out.innerHTML = 'RetroCore Mobile Shell';
      } else {
        out.innerHTML += '<br>Command not found';
      }
      e.target.value = '';
      out.scrollTop = out.scrollHeight;
    });

    function updateClock() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      document.getElementById('clock').textContent = h + ':' + m;
    }
    setInterval(updateClock, 1000);
    updateClock();

    let streamOn = false;
    function toggleStreamMode() {
      streamOn = !streamOn;
      const btn = document.getElementById('stream-btn');
      btn.textContent = streamOn ? 'STREAM ON' : 'STREAM OFF';
      btn.style.background = streamOn ? '#00d8ff' : '#ff00ff';
      btn.style.color = streamOn ? '#000' : '#fff';
    }

    const canvas = document.getElementById('snakeCanvas');
    const ctx = canvas.getContext('2d');
    const scoreEl = document.getElementById('snake-score');
    const bestEl = document.getElementById('snake-best');
    const grid = 20;
    let snake = [{x: 7, y: 10}, {x: 6, y: 10}, {x: 5, y: 10}];
    let dir = {x: 1, y: 0};
    let nextDir = {x: 1, y: 0};
    let food = {x: 12, y: 10};
    let score = 0, best = Number(localStorage.getItem('retroSnakeBest') || 0);
    let intervalId = null;
    let mode = 'normal';

    function setSnakeMode(m) {
      mode = m;
      resetSnake();
    }

    function resetSnake() {
      snake = [{x: 7, y: 10}, {x: 6, y: 10}, {x: 5, y: 10}];
      dir = {x: 1, y: 0};
      nextDir = {x: 1, y: 0};
      food = {x: 12, y: 10};
      score = 0;
      scoreEl.textContent = '0';
      startSnakeLoop();
    }

    function placeFood() {
      let x = Math.floor(Math.random() * (canvas.width / grid));
      let y = Math.floor(Math.random() * (canvas.height / grid));
      for (const seg of snake) {
        if (seg.x === x && seg.y === y) return placeFood();
      }
      food = {x, y};
    }

    function startSnakeLoop() {
      clearInterval(intervalId);
      const speed = mode === 'turbo' ? 110 : mode === 'infinite' ? 100 : 170;
      intervalId = setInterval(gameTick, speed);
    }

    function gameTick() {
      dir = nextDir;
      const head = {x: snake[0].x + dir.x, y: snake[0].y + dir.y};

      if (mode !== 'infinite') {
        if (head.x < 0 || head.y < 0 || head.x >= canvas.width / grid || head.y >= canvas.height / grid) {
          endGame();
          return;
        }
      } else {
        if (head.x < 0) head.x = (canvas.width / grid) - 1;
        if (head.y < 0) head.y = (canvas.height / grid) - 1;
        if (head.x >= canvas.width / grid) head.x = 0;
        if (head.y >= canvas.height / grid) head.y = 0;
      }

      snake.unshift(head);

      if (head.x === food.x && head.y === food.y) {
        score += 1;
        scoreEl.textContent = score;
        if (score > best) {
          best = score;
          localStorage.setItem('retroSnakeBest', String(best));
          bestEl.textContent = String(best);
        }
        placeFood();
      } else {
        snake.pop();
      }

      if (snake.slice(1).some(part => part.x === head.x && part.y === head.y)) {
        endGame();
      }

      drawSnake();
    }

    function endGame() {
      clearInterval(intervalId);
      ctx.fillStyle = 'rgba(255,0,0,0.9)';
      ctx.font = 'bold 22px sans-serif';
      ctx.fillText('Game Over', 70, 110);
    }

    function drawSnake() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#111';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      for (let i = 0; i < snake.length; i++) {
        const cell = snake[i];
        ctx.fillStyle = i === 0 ? '#7fff5a' : '#d2ffd0';
        ctx.fillRect(cell.x * grid, cell.y * grid, grid - 1, grid - 1);
      }

      ctx.fillStyle = '#ff4d4d';
      ctx.fillRect(food.x * grid, food.y * grid, grid - 1, grid - 1);
    }

    function moveDirection(input) {
      const mapping = {
        up: {x: 0, y: -1},
        down: {x: 0, y: 1},
        left: {x: -1, y: 0},
        right: {x: 1, y: 0}
      };
      const target = mapping[input];
      if (!target) return;
      const isOpposite = target.x === -dir.x && target.y === -dir.y;
      if (!isOpposite) nextDir = target;
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp') moveDirection('up');
      if (e.key === 'ArrowDown') moveDirection('down');
      if (e.key === 'ArrowLeft') moveDirection('left');
      if (e.key === 'ArrowRight') moveDirection('right');
    });

    document.querySelectorAll('[data-dir]').forEach(btn => {
      btn.addEventListener('click', () => moveDirection(btn.dataset.dir));
      btn.addEventListener('touchstart', (e) => {
        e.preventDefault();
        moveDirection(btn.dataset.dir);
      });
    });

    bestEl.textContent = best;
    drawSnake();
    resetSnake();

    let trackIndex = 0;
    const tracks = ['Phonk Mix', 'Synthwave Boom', 'Night Drive'];
    function controlMusic(action) {
      const name = document.getElementById('track-name');
      const status = document.getElementById('track-status');
      const bar = document.getElementById('track-bar');
      if (action === 'next') trackIndex = (trackIndex + 1) % tracks.length;
      if (action === 'prev') trackIndex = (trackIndex - 1 + tracks.length) % tracks.length;
      if (action === 'play') {
        name.textContent = tracks[trackIndex];
        status.textContent = 'Status: Playing';
        let progress = 0;
        clearInterval(window.musicTimer);
        window.musicTimer = setInterval(() => {
          progress += 8;
          if (progress > 100) progress = 0;
          bar.style.width = progress + '%';
        }, 200);
      }
      if (action === 'pause') {
        status.textContent = 'Status: Paused';
        clearInterval(window.musicTimer);
      }
      if (action === 'play' || action === 'next' || action === 'prev') {
        name.textContent = tracks[trackIndex];
      }
    }

    document.querySelectorAll('.window-header').forEach(header => {
      const win = header.parentElement;
      let dragging = false;
      let offsetX = 0, offsetY = 0;
      header.addEventListener('pointerdown', (e) => {
        dragging = true;
        const rect = win.getBoundingClientRect();
        offsetX = e.clientX - rect.left;
        offsetY = e.clientY - rect.top;
        header.setPointerCapture(e.pointerId);
      });
      header.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const parent = win.parentElement;
        const maxX = parent.clientWidth - win.offsetWidth;
        const maxY = parent.clientHeight - win.offsetHeight;
        let x = e.clientX - offsetX;
        let y = e.clientY - offsetY;
        x = Math.max(0, Math.min(x, maxX));
        y = Math.max(0, Math.min(y, maxY));
        win.style.left = x + 'px';
        win.style.top = y + 'px';
      });
      header.addEventListener('pointerup', () => dragging = false);
      header.addEventListener('pointercancel', () => dragging = false);
    });

    document.querySelectorAll('.desktop-icon').forEach(item => {
      item.addEventListener('click', () => {
        if (item.dataset.window) openWindow(item.dataset.window);
      });
    });
  </script>
</body>
</html>
