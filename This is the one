<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Windows XP Boot Screen</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        user-select: none;
      }

      html, body {
        width: 100%;
        height: 100%;
        background: #000;
        overflow: hidden;
      }

      body {
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
        color: #fff;
      }

      .boot-screen {
        width: 100%;
        max-width: 640px;
        height: 480px;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 40px 20px 18px;
        background: #000;
      }

      .logo-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 60px;
      }

      .flag {
        display: grid;
        grid-template-columns: repeat(2, 22px);
        grid-gap: 3px;
        margin-bottom: 15px;
        transform: skewX(-10deg);
      }

      .flag-piece {
        width: 22px;
        height: 20px;
        border-radius: 2px;
      }

      .red { background-color: #f24c25; border-bottom-right-radius: 6px; }
      .green { background-color: #7dba1b; border-bottom-left-radius: 6px; }
      .blue { background-color: #00a1f1; border-top-right-radius: 6px; }
      .yellow { background-color: #ffbc00; border-top-left-radius: 6px; }

      .brand-text {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -1px;
        text-align: center;
        text-transform: uppercase;
        font-style: italic;
        line-height: 0.95;
      }

      .brand-text .microsoft {
        font-weight: 300;
        font-size: 24px;
        display: block;
        margin-bottom: -5px;
        letter-spacing: 1px;
        text-transform: none;
        font-style: normal;
      }

      .brand-text .windows {
        display: inline-flex;
        align-items: center;
        gap: 2px;
      }

      .brand-text .reg {
        font-size: 16px;
        font-weight: 700;
        font-style: normal;
        vertical-align: super;
      }

      .edition-text {
        color: #f1a142;
        font-size: 14px;
        font-weight: bold;
        letter-spacing: 2px;
        margin-top: 2px;
        text-transform: uppercase;
      }

      .loading-container {
        width: 156px;
        margin-bottom: 40px;
      }

      .track {
        width: 100%;
        height: 15px;
        border: 2px solid #999;
        border-radius: 4px;
        padding: 1px;
        overflow: hidden;
        position: relative;
        background-color: #000;
      }

      .marquee {
        display: flex;
        gap: 2px;
        width: 34px;
        height: 100%;
        position: absolute;
        left: -34px;
        animation: scroll-loading 2.5s linear infinite;
      }

      .block {
        flex: 1;
        height: 100%;
        background: linear-gradient(to bottom, #285ed3 0%, #4784fa 50%, #285ed3 100%);
        border-radius: 1px;
      }

      .footer {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-top: 1px solid #333;
        padding-top: 15px;
        font-size: 11px;
        color: #888;
      }

      .copyright {
        max-width: 60%;
      }

      .company-logo {
        font-weight: 800;
        font-size: 14px;
        color: #fff;
        letter-spacing: -0.5px;
      }

      .company-logo span {
        font-weight: 300;
        font-size: 11px;
        display: block;
        margin-bottom: -4px;
        color: #888;
      }

      @keyframes scroll-loading {
        0% { left: -34px; }
        100% { left: 156px; }
      }
    </style>
  </head>
  <body>
    <div class="boot-screen" aria-label="Windows XP boot screen">
      <div class="logo-container">
        <div class="flag" aria-hidden="true">
          <div class="flag-piece red"></div>
          <div class="flag-piece green"></div>
          <div class="flag-piece blue"></div>
          <div class="flag-piece yellow"></div>
        </div>

        <h1 class="brand-text">
          <span class="microsoft">Microsoft</span>
          <span class="windows">Windows xp<span class="reg">®</span></span>
        </h1>

        <div class="edition-text">Professional</div>
      </div>

      <div class="loading-container" aria-label="loading progress">
        <div class="track">
          <div class="marquee">
            <div class="block"></div>
            <div class="block"></div>
            <div class="block"></div>
          </div>
        </div>
      </div>

      <div class="footer">
        <div class="copyright">Copyright © Microsoft Corporation</div>
        <div class="company-logo"><span>Microsoft</span></div>
      </div>
    </div>
  </body>
</html>
