    const canvas = document.getElementById('snakeGameCanvas');
    const ctx = canvas.getContext('2d');
    const boxSize = 10;
    let snake, food, score, maxScore, snakeDir, gameInterval, snakeSpeed;
    let snakeMode = 'normal';

    maxScore = localStorage.getItem('retroSnakeMax') || 0;
    document.getElementById('s-high').textContent = maxScore;

    function startSnake() {
      clearInterval(gameInterval);
      score = 0;
      snakeDir = null;
      document.getElementById('s-score').textContent = score;
      snake = [{ x: 15 * boxSize, y: 10 * boxSize }];
      spawnSnakeFood();
      snakeSpeed = snakeMode === 'turbo' ? 45 : 100;
      gameInterval = setInterval(gameStep, snakeSpeed);
