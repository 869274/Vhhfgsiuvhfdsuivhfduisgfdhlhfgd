      if (e.keyCode == 39 && snakeDir != 'LEFT') snakeDir = 'RIGHT';
      if (e.keyCode == 40 && snakeDir != 'UP') snakeDir = 'DOWN';
    });
    function gameStep() {
      ctx.fillStyle = '#0d0d0d';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      for (let i = 0; i < snake.length; i++) {
        ctx.fillStyle = i == 0 ? '#398a23' : '#ffffff';
