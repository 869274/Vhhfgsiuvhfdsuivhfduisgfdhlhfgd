      setTimeout(() => win.classList.add('window-open'), 10);
      win.style.zIndex = ++topZ;
      openApps[id] = true;
      renderTaskbarApps();
    }
    function closeWindow(id) {
      const win = document.getElementById(id);
      if (!win) return;
      win.classList.remove('window-open');
      setTimeout(() => win.style.display = 'none', 150);
      delete openApps[id];
      renderTaskbarApps();
    }
    function minimizeWindow(id) {
      document.getElementById(id).style.display = 'none';
    }
    function maximizeWindow(id) {
      document.getElementById(id).classList.toggle('maximized');
    }
    function renderTaskbarApps() {
      const container = document.getElementById('open-apps-container');
      container.innerHTML = '';
      for (const id in openApps) {
        const btn = document.createElement('button');
        btn.className = 'taskbar-app-btn';
        const name = id.replace('win-', '').toUpperCase();
        btn.textContent = name;
        btn.onclick = () => {
          const win = document.getElementById(id);
          if (win.style.display === 'none') {
            win.style.display = 'block';
            win.style.zIndex = ++topZ;
          } else {
            win.style.zIndex = ++topZ;
          }
        };
        container.appendChild(btn);
      }
    }

    document.querySelectorAll('.window').forEach(win => {
      const header = win.querySelector('.window-header');
      header.addEventListener('mousedown', (e) => {
        if (e.target.tagName === 'BUTTON') return;
        const sX = e.clientX - win.getBoundingClientRect().left;
        const sY = e.clientY - win.getBoundingClientRect().top;
        win.style.zIndex = ++topZ;

        function move(ev) {
          let nx = ev.clientX - sX;
          let ny = ev.clientY - sY;
          if (ny < 0) ny = 0;
          if (nx < 0) nx = 0;
          win.style.left = nx + 'px';
          win.style.top = ny + 'px';
        }
        document.addEventListener('mousemove', move);
        document.onmouseup = function () {
          document.removeEventListener('mousemove', move);
          document.onmouseup = null;
        };
      });
    });

