        if (headX < 0) headX = canvas.width - boxSize;
        if (headX >= canvas.width) headX = 0;
        if (headY < 0) headY = canvas.height - boxSize;
        if (headY >= canvas.height) headY = 0;
      }

      if (headX == food.x && headY == food.y) {
        score++;
        document.getElementById('s-score').textContent = score;
        playOscillatorSound(880, 60);
        if (score > maxScore) {
          maxScore = score;
          localStorage.setItem('retroSnakeMax', maxScore);
          document.getElementById('s-high').textContent = maxScore;
        }
        spawnSnakeFood();
      } else {
        if (snakeDir) snake.pop();
      }

      const newHead = { x: headX, y: headY };
      if (snakeDir) {
        if (snakeMode !== 'infinite' && (headX < 0 || headX >= canvas.width || headY < 0 || headY >= canvas.height)) {
          endSnakeGame();
          return;
        }
        if (snake.some(s => s.x == newHead.x && s.y == newHead.y)) {
          endSnakeGame();
          return;
        }
        snake.unshift(newHead);
      }
    }
    function endSnakeGame() {
      clearInterval(gameInterval);
      playOscillatorSound(180, 350);
      ctx.fillStyle = 'orange';
      ctx.font = '14pt monospace';
      ctx.fillText('CANCELLED / GAME OVER', 60, 110);
    }

    const tracks = ['Bass_Phonk_Special.mp3', 'Hyper_Synthwave_XP.mp3', 'AuraOS_Symphony_6.mp3'];
    let trackIdx = 0; let mTimer; let mBarVal = 0;
    function controlMusic(action) {
      const title = document.getElementById('track-title');
      const status = document.getElementById('track-status');
      const bar = document.getElementById('m-bar');
      if (action === 'play') {
        title.textContent = tracks[trackIdx];
        status.textContent = 'Status: Playing...';
        clearInterval(mTimer);
        mTimer = setInterval(() => {
          mBarVal = (mBarVal + 5) % 105;
          bar.style.width = mBarVal + '%';
        }, 400);
      } else if (action === 'pause' || action === 'stop') {
        status.textContent = 'Status: Stopped';
        clearInterval(mTimer);
        if (action === 'stop') {
          mBarVal = 0;
          bar.style.width = '0%';
        }
      } else if (action === 'next') {
        trackIdx = (trackIdx + 1) % tracks.length;
        controlMusic('play');
      } else if (action === 'prev') {
        trackIdx = (trackIdx - 1 + tracks.length) % tracks.length;
        controlMusic('play');
      }
    }

    function handleCmd(event) {
      if (event.key === 'Enter') {
        const field = document.getElementById('cmd-input-field');
        const history = document.getElementById('cmd-history');
        const val = field.value.toLowerCase().trim();
        let output = '';

        if (val === 'help') {
          output = "Commands:\n version - OS version\n stream_status - Stream status\n virus_test - Malware demo\n snake_stats - Game record\n clear - Clear terminal\n help - List commands";
        } else if (val === 'version') {
          output = 'RetroCore Windows 5.0 [Ultimate Stream Edition 2026]';
        } else if (val === 'stream_status') {
          output = streamerActive ? 'ACTIVE | Live broadcasting' : 'OFF | Start from the taskbar';
        } else if (val === 'virus_test') {
          output = 'Launching lab call...';
          setTimeout(() => runVirusStage1(), 1000);
        } else if (val === 'snake_stats') {
          output = 'Best score: ' + maxScore;
        } else if (val === 'clear') {
          history.textContent = '';
          field.value = '';
          return;
        } else if (!val) {
          output = '';
        } else {
          output = 'Unknown command: ' + field.value;
        }

        history.innerHTML += '<div><br> C:\\Angelo_OS> ' + field.value + '<br>' + output.replace(/\n/g, '<br>') + '</div>';
        field.value = '';
        const box = document.querySelector('.cmd-box');
        box.scrollTop = box.scrollHeight;
      }
    }

    function playOscillatorSound(freq, duration) {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        const ctxAudio = new AudioCtx();
        const oscillator = ctxAudio.createOscillator();
        const gain = ctxAudio.createGain();
        oscillator.type = 'square';
        oscillator.frequency.value = freq;
        gain.gain.value = 0.03;
        oscillator.connect(gain);
        gain.connect(ctxAudio.destination);
        oscillator.start();
        setTimeout(() => {
          oscillator.stop();
          oscillator.disconnect();
          gain.disconnect();
          ctxAudio.close();
        }, duration);
      } catch (err) {
        console.log('Audio not available:', err);
      }
    }

    function runVirusStage1() {
      const box = document.getElementById('virus-lab-body');
      box.innerHTML = '<h4>Stage 1: Signature Scan</h4><p>Analyzing the desktop layer...</p><button onclick="runVirusStage2()" style="padding:8px 16px; font-weight:bold; cursor:pointer; background:linear-gradient(to bottom, #ff4d4d, #cc0000); color:white; border:1px solid #990000;">Continue</button>';
      playOscillatorSound(440, 180);
    }
    function runVirusStage2() {
      const box = document.getElementById('virus-lab-body');
      box.innerHTML = '<h4>Stage 2: Visual Override</h4><p>Injecting graphical pulses...</p><button onclick="runVirusStage3()" style="padding:8px 16px; font-weight:bold; cursor:pointer; background:linear-gradient(to bottom, #ff4d4d, #cc0000); color:white; border:1px solid #990000;">Continue</button>';
      document.getElementById('virus-ransom-box').style.display = 'block';
      playOscillatorSound(660, 140);
    }
    function runVirusStage3() {
      const box = document.getElementById('virus-lab-body');
      box.innerHTML = '<h4>Stage 3: Security Layer Drift</h4><p>Bypassing warning signal...</p><button onclick="runVirusStage4()" style="padding:8px 16px; font-weight:bold; cursor:pointer; background:linear-gradient(to bottom, #ff4d4d, #cc0000); color:white; border:1px solid #990000;">Execute</button>';
      playOscillatorSound(800, 120);
    }
    function runVirusStage4() {
      document.getElementById('virus-ransom-box').style.display = 'none';
      document.getElementById('bsod').style.display = 'block';
      const win = document.getElementById('win-virus');
      win.classList.add('vibrate-active');
      setTimeout(() => win.classList.remove('vibrate-active'), 800);
    }
    function triggerBsodStage4() {
      runVirusStage4();
    }

    function updateClock() {
      const now = new Date();
      const time = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      document.getElementById('digital-clock').textContent = time;
    }
    setInterval(updateClock, 1000);
    updateClock();
    startSnake();
  </script>
