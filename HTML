    function spawnSnakeFood() {
      food = { x: Math.floor(Math.random() * 32) * boxSize, y: Math.floor(Math.random() * 22) * boxSize };
    }
    function setSnakeMode(mode) {
      snakeMode = mode;
      document.getElementById('s-mode-lbl').textContent = mode.toUpperCase();
      startSnake();
    }
    document.addEventListener('keydown', e => {
      if (e.keyCode == 37 && snakeDir != 'RIGHT') snakeDir = 'LEFT';
